# Environment
NODE_ENV=production
ENVIRONMENT=production

# Application URLs (Production)
FRONTEND_URL=http://172.20.150.127
API_URL=http://172.20.150.127
VITE_API_URL=http://172.20.150.127
CORS_ORIGIN=http://172.20.150.127

# Ports (Production)
PORT=5000
FRONTEND_PORT=80

# SQL Server Database (Production)
DB_HOST=mssql
DB_PORT=1433
DB_NAME=InventoryManagementDB
DB_USER=sa
DB_PASSWORD=Pakistan@786
DB_ENCRYPT=true
DB_TRUST_CERT=true

# SQL Server Configuration (Backend compatibility)
SQL_SERVER_HOST=mssql
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=InventoryManagementDB
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=Pakistan@786
SQL_SERVER_ENCRYPT=true
SQL_SERVER_TRUST_CERT=true

# Security (Production - Strict)
JWT_SECRET=CHANGE-THIS-TO-SECURE-256-BIT-KEY-FOR-PRODUCTION
JWT_EXPIRES_IN=8h
SESSION_SECRET=CHANGE-THIS-TO-SECURE-SESSION-SECRET
BCRYPT_ROUNDS=12

# Logging (Production - Minimal)
LOG_LEVEL=error
ENABLE_REQUEST_LOGGING=false
ENABLE_SQL_LOGGING=false
ENABLE_DEBUG_MODE=false

# Features (Production)
ENABLE_DUAL_PRICING=true
ENABLE_CUSTOM_ITEMS=true
ENABLE_APPROVAL_FORWARDING=true

# Production Settings
ENABLE_CORS=true
CORS_ORIGINS=http://172.20.150.127
RATE_LIMIT_ENABLED=true
CACHE_ENABLED=true
COMPRESSION_ENABLED=true
HELMET_ENABLED=true
PRODUCTION_MODE=true

# Performance
DB_CONNECTION_TIMEOUT=15000
DB_REQUEST_TIMEOUT=10000
API_TIMEOUT=10000

#  IMPORTANT: 
# - Change JWT_SECRET and SESSION_SECRET before deploying
# - Update FRONTEND_URL and API_URL to actual domain
# - Enable SSL/TLS (DB_ENCRYPT=true)
# - Use strong passwords
# - Review all security settings
